spring:
  application:
    name: OLX-Advertises
  config:
    import: "optional:configserver:http://localhost:8888/"

server:
  port: 9090
eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
  instance:
    prefer-ip-address: true
    hostname: localhost
 
management:
  endpoints:
    web:
      exposure:
        exclude:
        - include: "*"
  health:
	  circuitbreakers:
		   enabled: true
	endpoint:
		health:
		  show-details: 

		springdoc:
		  show-actuator: true
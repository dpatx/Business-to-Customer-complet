package com.zensar.service;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.cloud.client.circuitbreaker.CircuitBreakerFactory;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpMethod;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

@Service
public class UserDelegateImpl implements UserDelegate {

	@Autowired
	RestTemplate restTemplate;
	
	//@Autowired
	 private  UserAuthClient userAuthClient;
	
	 private CircuitBreakerFactory circuitBreakerFactory;
	
	UserDelegateImpl(CircuitBreakerFactory circuitBreakerFactory ,UserAuthClient userAuthClient){
		this.circuitBreakerFactory = circuitBreakerFactory;
		this.userAuthClient = userAuthClient;
		
	}
	
	@Override
	public boolean isTokenValid(String authToken) {
		/*
		 * HttpHeaders headers = new HttpHeaders(); headers.set("Authorization",
		 * authToken); HttpEntity<String> httpEntity = new HttpEntity<>(headers);
		 * ResponseEntity<Boolean> result = restTemplate.exchange(
		 * "http://OLX-LOGIN/user-management/user/token/validate", HttpMethod.GET,
		 * httpEntity, Boolean.class); //Remote call boolean isTokenValid =
		 * result.getBody();
		 */
		circuitBreakerFactory.create("TOKEN-VALIDATION").run(() -> userAuthClient.validateToken(authToken),
				(throwable) -> isFaultorelance(authToken, throwable));
		ResponseEntity<Boolean> response = userAuthClient.validateToken(authToken);
        
        return response.getBody() != null && response.getBody();
		//return isTokenValid;
	}
     
	private Boolean isFaultorelance(String authToken, Throwable throwable ) {
		return throwable==null?false:true;
	}
}


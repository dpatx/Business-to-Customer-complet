spring:
  application:
    name: OLX-Login
  config:
    import: "optional:configserver:http://localhost:8888/"

eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
  instance:
    prefer-ip-address: true
    hostname: localhost
server:
  port: 8089
management:
  endpoints:
    web:
      exposure:
        include: "*"
  health:
    circuitbreakers:
      enabled: true
  endpoint:
    health:
      show-details: 

springdoc:
	show-actuator: true
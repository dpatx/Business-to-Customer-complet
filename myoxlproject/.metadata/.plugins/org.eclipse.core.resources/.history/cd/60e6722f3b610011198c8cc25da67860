package com.zensar.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.security.authentication.AuthenticationManager;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.Authentication;

import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.*;

import com.zensar.dto.UserDto;

import io.swagger.v3.oas.annotations.parameters.RequestBody;

@RestController
@RequestMapping("/user-management")
public class UserManagmentController {
	
	@Autowired
	AuthenticationManager authenticationManager;
	
	
	@PostMapping(value = "/user/authenticate", consumes = MediaType.APPLICATION_JSON_VALUE) // Public endpoint
	public ResponseEntity<String> login(@RequestBody UserDto userDto) {
		System.out.println(userDto.toString());
		Authentication auth = new UsernamePasswordAuthenticationToken(userDto.getUsername(), userDto.getPassword());
		authenticationManager.authenticate(auth);
		return new ResponseEntity<String>("my test", HttpStatus.OK);
	
	}
}
